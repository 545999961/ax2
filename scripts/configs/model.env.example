# Copy to .env, edit, then: set -a; source .env; set +a
AREX_MODEL_NAME=provider/model-name
AREX_API_KEY_ENV=MODEL_API_KEY
MODEL_API_KEY=
AREX_BASE_URL=https://api.example.com/v1
# Research agents count tokens locally; use the tokenizer for your served model.
AREX_TOKENIZER_PATH=

# The refine-equal profile requires an external judge. Summary requests reuse
# the inference model and endpoint; only set the summary variables for a
# deliberate --profile default override.
AREX_JUDGE_MODEL=judge-model-name
AREX_JUDGE_API_KEY_ENV=JUDGE_API_KEY
JUDGE_API_KEY=
AREX_JUDGE_BASE_URL=https://judge.example.com/v1
AREX_SUMMARY_MODEL=
AREX_SUMMARY_API_KEY_ENV=
AREX_SUMMARY_BASE_URL=

SERPER_API_KEY=
JINA_API_KEY=
SERPER_API_URL=https://google.serper.dev/search
SERPER_SCHOLAR_API_URL=https://google.serper.dev/scholar
JINA_API_URL=https://r.jina.ai

# Required only for gated HLE and GAIA downloads after accepting their terms.
HF_TOKEN=
# Blank defaults to the repository's data/files/ directory.
AREX_DATA_ROOT=
